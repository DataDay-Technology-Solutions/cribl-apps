{
  "sourcetype":"cisco:asa","vendor":"Cisco","product":"ASA","format":"syslog",
  "description":"Cisco ASA firewall syslog messages",
  "fields":[
    {"name":"ts","type":"timestamp","config":{"format":"MMM DD YYYY HH:mm:ss","jitterMs":3000}},
    {"name":"hostname","type":"hostname","config":{"pool":["FW-ASA-01","FW-ASA-02","FW-ASA-DC1","FW-ASA-DC2","FW-ASA-DMZ","FW-ASA-EDGE","FW-ASA-CORE","ASA-5525X-01","ASA-5545X-01","ASA-5555X-01","ASA-FP4110-01","ASA-FP9300-01"]}},
    {"name":"src_ip","type":"ip","config":{"internal":[{"cidr":"10.0.0.0/8","weight":0.4},{"cidr":"192.168.0.0/16","weight":0.2},{"cidr":"172.16.0.0/12","weight":0.1}],"external":[{"cidr":"0.0.0.0/0","weight":0.3}]}},
    {"name":"dst_ip","type":"ip","config":{"internal":[{"cidr":"10.0.0.0/8","weight":0.3},{"cidr":"172.16.0.0/12","weight":0.1}],"external":[{"cidr":"0.0.0.0/0","weight":0.6}]}},
    {"name":"src_port","type":"port","config":{"type":"ephemeral"}},
    {"name":"dst_port","type":"port","config":{"common":[443,80,53,8080,22,25,3389,445,389,636],"weights":[0.25,0.18,0.12,0.08,0.07,0.06,0.06,0.06,0.06,0.06]}},
    {"name":"protocol","type":"enum","config":{"values":["TCP","UDP","ICMP","GRE"],"weights":[0.65,0.25,0.07,0.03]}},
    {"name":"iface_in","type":"enum","config":{"values":["inside","outside","dmz","management","vpn","guest"],"weights":[0.35,0.25,0.15,0.08,0.1,0.07]}},
    {"name":"iface_out","type":"enum","config":{"values":["outside","inside","dmz","management","vpn","guest"],"weights":[0.35,0.25,0.15,0.08,0.1,0.07]}},
    {"name":"bytes","type":"int","config":{"min":60,"max":1048576}},
    {"name":"duration","type":"string","config":{"pool":["0:00:01","0:00:05","0:00:10","0:00:30","0:01:00","0:02:00","0:05:00","0:10:00","0:30:00","1:00:00","2:00:00","4:00:00"]}},
    {"name":"access_group","type":"string","config":{"pool":["INSIDE_IN","OUTSIDE_IN","DMZ_IN","VPN_IN","GLOBAL_POLICY","MGMT_IN","GUEST_IN","PCI_ACL","HIPAA_ACL","CORP_EGRESS"]}},
    {"name":"xlate_src","type":"ip","config":{"internal":[{"cidr":"198.51.100.0/24","weight":0.5},{"cidr":"203.0.113.0/24","weight":0.5}]}},
    {"name":"xlate_dst","type":"ip","config":{"internal":[{"cidr":"10.10.0.0/16","weight":1}]}},
    {"name":"conn_id","type":"int","config":{"min":100000,"max":99999999}},
    {"name":"user","type":"username","config":{"domain":"CORP\\","pattern":"{first}.{last}"}},
    {"name":"command","type":"string","config":{"pool":["show running-config","show version","write memory","configure terminal","show crypto ipsec sa","show failover","show conn count","changeto context admin","show access-list","copy running-config startup-config","show interface","show route","debug crypto ipsec","packet-tracer input inside tcp"]}}
  ],
  "variants":{
    "built_conn":{"weight":0.35,
      "fields":{"severity":"6","code":"302013"},
      "template":"{{ts}} {{hostname}} %ASA-6-302013: Built {{protocol}} connection {{conn_id}} for {{iface_in}}:{{src_ip}}/{{src_port}} ({{xlate_src}}/{{src_port}}) to {{iface_out}}:{{dst_ip}}/{{dst_port}} ({{dst_ip}}/{{dst_port}})"},
    "teardown":{"weight":0.30,
      "fields":{"severity":"6","code":"302014"},
      "template":"{{ts}} {{hostname}} %ASA-6-302014: Teardown TCP connection {{conn_id}} for {{iface_in}}:{{src_ip}}/{{src_port}} to {{iface_out}}:{{dst_ip}}/{{dst_port}} duration {{duration}} bytes {{bytes}} {{protocol}} FINs"},
    "deny":{"weight":0.15,
      "fields":{"severity":"4","code":"106023"},
      "template":"{{ts}} {{hostname}} %ASA-4-106023: Deny {{protocol}} src {{iface_in}}:{{src_ip}}/{{src_port}} dst {{iface_out}}:{{dst_ip}}/{{dst_port}} by access-group \"{{access_group}}\" [0x0, 0x0]"},
    "nat":{"weight":0.12,
      "fields":{"severity":"6","code":"305011"},
      "template":"{{ts}} {{hostname}} %ASA-6-305011: Built dynamic {{protocol}} translation from {{iface_in}}:{{src_ip}}/{{src_port}} to {{iface_out}}:{{xlate_src}}/{{src_port}}"},
    "command":{"weight":0.08,
      "fields":{"severity":"5","code":"111008"},
      "template":"{{ts}} {{hostname}} %ASA-5-111008: User '{{user}}' executed the '{{command}}' command."}
  },
  "template":"{{ts}} {{hostname}} %ASA-{{severity}}-{{code}}: {{msg}}",
  "correlationHints":{"actor_ip":"src_ip","actor_user":"user","target_ip":"dst_ip","target_port":"dst_port"}
}