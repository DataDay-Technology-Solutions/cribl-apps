{
  "sourcetype":"cloudflare:waf","vendor":"Cloudflare","product":"Cloudflare WAF/CDN","format":"json",
  "description":"Cloudflare WAF and CDN access log events",
  "templatePrefix":"{",
  "templateSuffix":"}",
  "fields":[
    {"name":"ts","type":"timestamp","config":{"format":"iso","jitterMs":3000}},
    {"name":"ray","type":"hash","config":{"algorithm":"random_hex","length":16}},
    {"name":"casn","type":"int","config":{"min":1000,"max":65535}},
    {"name":"cc","type":"enum","config":{"values":["US","GB","DE","FR","JP","CN","RU","BR","IN","CA","AU","NL","SG"],"weights":[0.2,0.1,0.08,0.07,0.07,0.08,0.06,0.06,0.06,0.05,0.05,0.06,0.06]}},
    {"name":"cip","type":"ip","config":{"external":[{"cidr":"0.0.0.0/0","weight":1}]}},
    {"name":"chost","type":"string","config":{"pool":["www.example.com","api.example.com","app.example.com","cdn.example.com","shop.example.com","blog.example.com","auth.example.com"]}},
    {"name":"method","type":"enum","config":{"values":["GET","POST","PUT","DELETE","PATCH","OPTIONS","HEAD"],"weights":[0.5,0.2,0.06,0.04,0.05,0.08,0.07]}},
    {"name":"path","type":"string","config":{"pool":["/","/api/v1/users","/api/v1/auth/login","/api/v1/search","/wp-login.php","/admin","/.env","/favicon.ico","/robots.txt","/graphql","/.git/config","/../../../etc/passwd","/api/v1/users?id=1%27%20OR%201=1","/phpmyadmin/","/static/js/app.min.js"]}},
    {"name":"proto","type":"enum","config":{"values":["HTTP/1.1","HTTP/2","HTTP/3"],"weights":[0.3,0.5,0.2]}},
    {"name":"scheme","type":"enum","config":{"values":["https","http"],"weights":[0.92,0.08]}},
    {"name":"ua","type":"useragent","config":{}},
    {"name":"colo","type":"enum","config":{"values":["DFW","ORD","LAX","SFO","IAD","AMS","LHR","FRA","NRT","SIN","SYD","YYZ","GRU","CDG","SEA"],"weights":[0.08,0.08,0.08,0.07,0.09,0.07,0.07,0.07,0.06,0.06,0.05,0.05,0.05,0.05,0.07]}},
    {"name":"erbytes","type":"int","config":{"min":200,"max":524288}},
    {"name":"erct","type":"enum","config":{"values":["text/html","application/json","image/png","text/css","application/javascript","text/plain"],"weights":[0.25,0.3,0.1,0.1,0.15,0.1]}},
    {"name":"erst","type":"enum","config":{"values":[200,301,304,400,403,404,429,500,503],"weights":[0.4,0.06,0.08,0.07,0.08,0.1,0.06,0.07,0.08]}},
    {"name":"oip","type":"ip","config":{"internal":[{"cidr":"10.0.0.0/8","weight":0.5}],"external":[{"cidr":"0.0.0.0/0","weight":0.5}]}},
    {"name":"orst","type":"enum","config":{"values":[200,301,304,400,403,404,500,503],"weights":[0.45,0.05,0.08,0.07,0.07,0.1,0.08,0.1]}},
    {"name":"ort","type":"int","config":{"min":5,"max":30000}},
    {"name":"wafRuleId","type":"string","config":{"pool":["100001","100002","100015","949110","941100","942100","931100","932100"]}},
    {"name":"wafMsg","type":"string","config":{"pool":["SQL Injection Attack Detected","Cross-Site Scripting (XSS) Attack","Remote File Inclusion Attempt","Path Traversal Attack","Command Injection Attempt","Anomaly Score Exceeded"]}},
    {"name":"zoneId","type":"hash","config":{"algorithm":"random_hex","length":32}},
    {"name":"fwSrc","type":"enum","config":{"values":["firewallRules","rateLimit","waf","bic","zoneLockdown","uaBlock","ip"],"weights":[0.25,0.15,0.22,0.1,0.1,0.08,0.1]}}
  ],
  "variants":{
    "allow":{"weight":0.45,
      "fields":{},
      "bodyTemplate":"\"RayID\":\"{{ray}}\",\"Action\":\"allow\",\"ClientASN\":{{casn}},\"ClientCountry\":\"{{cc}}\",\"ClientIP\":\"{{cip}}\",\"ClientRequestHost\":\"{{chost}}\",\"ClientRequestMethod\":\"{{method}}\",\"ClientRequestPath\":\"{{path}}\",\"ClientRequestProtocol\":\"{{proto}}\",\"ClientRequestScheme\":\"{{scheme}}\",\"ClientRequestUserAgent\":\"{{ua}}\",\"EdgeColoCode\":\"{{colo}}\",\"EdgeResponseBytes\":{{erbytes}},\"EdgeResponseContentType\":\"{{erct}}\",\"EdgeResponseStatus\":{{erst}},\"EdgeStartTimestamp\":\"{{ts}}\",\"FirewallMatchesActions\":[],\"FirewallMatchesRuleIDs\":[],\"FirewallMatchesSources\":[],\"OriginIP\":\"{{oip}}\",\"OriginResponseStatus\":{{orst}},\"OriginResponseTime\":{{ort}},\"WAFAction\":\"allow\",\"WAFProfile\":\"low\",\"WAFRuleID\":\"\",\"WAFRuleMessage\":\"Allowed\",\"ZoneID\":\"{{zoneId}}\""},
    "blocked":{"weight":0.20,
      "fields":{},
      "bodyTemplate":"\"RayID\":\"{{ray}}\",\"Action\":\"drop\",\"ClientASN\":{{casn}},\"ClientCountry\":\"{{cc}}\",\"ClientIP\":\"{{cip}}\",\"ClientRequestHost\":\"{{chost}}\",\"ClientRequestMethod\":\"{{method}}\",\"ClientRequestPath\":\"{{path}}\",\"ClientRequestProtocol\":\"{{proto}}\",\"ClientRequestScheme\":\"{{scheme}}\",\"ClientRequestUserAgent\":\"{{ua}}\",\"EdgeColoCode\":\"{{colo}}\",\"EdgeResponseBytes\":{{erbytes}},\"EdgeResponseContentType\":\"text/html\",\"EdgeResponseStatus\":403,\"EdgeStartTimestamp\":\"{{ts}}\",\"FirewallMatchesActions\":[\"drop\"],\"FirewallMatchesRuleIDs\":[\"{{wafRuleId}}\"],\"FirewallMatchesSources\":[\"{{fwSrc}}\"],\"OriginIP\":\"{{oip}}\",\"OriginResponseStatus\":0,\"OriginResponseTime\":0,\"WAFAction\":\"drop\",\"WAFProfile\":\"high\",\"WAFRuleID\":\"{{wafRuleId}}\",\"WAFRuleMessage\":\"{{wafMsg}}\",\"ZoneID\":\"{{zoneId}}\""},
    "challenge":{"weight":0.15,
      "fields":{},
      "bodyTemplate":"\"RayID\":\"{{ray}}\",\"Action\":\"managed_challenge\",\"ClientASN\":{{casn}},\"ClientCountry\":\"{{cc}}\",\"ClientIP\":\"{{cip}}\",\"ClientRequestHost\":\"{{chost}}\",\"ClientRequestMethod\":\"{{method}}\",\"ClientRequestPath\":\"{{path}}\",\"ClientRequestProtocol\":\"{{proto}}\",\"ClientRequestScheme\":\"{{scheme}}\",\"ClientRequestUserAgent\":\"{{ua}}\",\"EdgeColoCode\":\"{{colo}}\",\"EdgeResponseBytes\":{{erbytes}},\"EdgeResponseContentType\":\"text/html\",\"EdgeResponseStatus\":403,\"EdgeStartTimestamp\":\"{{ts}}\",\"FirewallMatchesActions\":[\"managed_challenge\"],\"FirewallMatchesRuleIDs\":[\"{{wafRuleId}}\"],\"FirewallMatchesSources\":[\"{{fwSrc}}\"],\"OriginIP\":\"{{oip}}\",\"OriginResponseStatus\":0,\"OriginResponseTime\":0,\"WAFAction\":\"challenge\",\"WAFProfile\":\"medium\",\"WAFRuleID\":\"{{wafRuleId}}\",\"WAFRuleMessage\":\"{{wafMsg}}\",\"ZoneID\":\"{{zoneId}}\""},
    "logged":{"weight":0.20,
      "fields":{},
      "bodyTemplate":"\"RayID\":\"{{ray}}\",\"Action\":\"log\",\"ClientASN\":{{casn}},\"ClientCountry\":\"{{cc}}\",\"ClientIP\":\"{{cip}}\",\"ClientRequestHost\":\"{{chost}}\",\"ClientRequestMethod\":\"{{method}}\",\"ClientRequestPath\":\"{{path}}\",\"ClientRequestProtocol\":\"{{proto}}\",\"ClientRequestScheme\":\"{{scheme}}\",\"ClientRequestUserAgent\":\"{{ua}}\",\"EdgeColoCode\":\"{{colo}}\",\"EdgeResponseBytes\":{{erbytes}},\"EdgeResponseContentType\":\"{{erct}}\",\"EdgeResponseStatus\":{{erst}},\"EdgeStartTimestamp\":\"{{ts}}\",\"FirewallMatchesActions\":[\"log\"],\"FirewallMatchesRuleIDs\":[\"{{wafRuleId}}\"],\"FirewallMatchesSources\":[\"{{fwSrc}}\"],\"OriginIP\":\"{{oip}}\",\"OriginResponseStatus\":{{orst}},\"OriginResponseTime\":{{ort}},\"WAFAction\":\"log\",\"WAFProfile\":\"medium\",\"WAFRuleID\":\"{{wafRuleId}}\",\"WAFRuleMessage\":\"{{wafMsg}}\",\"ZoneID\":\"{{zoneId}}\""}
  },
  "template":"{{templatePrefix}}{{bodyTemplate}}{{templateSuffix}}",
  "correlationHints":{"actor_ip":"cip","target_host":"chost","target_url":"path","origin_ip":"oip"}
}