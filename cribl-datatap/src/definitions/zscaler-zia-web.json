    {"name":"department","type":"enum","config":{"values":["Engineering","Finance","HR","Marketing","Sales","IT","Legal","Operations"],"weights":[0.18,0.13,0.1,0.13,0.15,0.15,0.06,0.1]}},
    {"name":"url","type":"string","config":{"pool":["https://www.google.com/search?q=security","https://login.microsoftonline.com/oauth2","https://github.com/org/repo/pull/42","https://zoom.us/j/1234567890","https://outlook.office365.com/owa/","https://console.aws.amazon.com/ec2","https://portal.azure.com/","https://salesforce.com/home","https://jira.atlassian.net/PROJ-1234","https://youtube.com/watch?v=abc123","https://suspicious-download.xyz/p.exe","https://phishing-site.tk/login.html"]}},
    {"name":"action","type":"enum","config":{"values":["Allowed","Blocked","Cautioned","Isolated"],"weights":[0.78,0.12,0.06,0.04]}},
    {"name":"urlcategory","type":"enum","config":{"values":["Web Search","Professional Services","Streaming Media","Social Networking","Information Technology","Finance","Cloud Infrastructure","Malware","Phishing"],"weights":[0.15,0.12,0.1,0.12,0.14,0.1,0.1,0.08,0.09]}},
    {"name":"dlpengine","type":"enum","config":{"values":["None","HIPAA","PCI","PII"],"weights":[0.76,0.08,0.08,0.08]}},
    {"name":"location","type":"enum","config":{"values":["HQ-Office","NYC-Office","SF-Office","London-Office","Remote-US","Remote-EU"],"weights":[0.22,0.18,0.18,0.12,0.18,0.12]}},
    {"name":"reqsize","type":"int","config":{"min":100,"max":102400}},
    {"name":"respsize","type":"int","config":{"min":200,"max":10485760}},
    {"name":"serverip","type":"ip","config":{"external":[{"cidr":"0.0.0.0/0","weight":1}]}},
    {"name":"clientip","type":"ip","config":{"internal":[{"cidr":"10.0.0.0/8","weight":0.5},{"cidr":"192.168.0.0/16","weight":0.3},{"cidr":"172.16.0.0/12","weight":0.2}]}},
    {"name":"reqmethod","type":"enum","config":{"values":["GET","POST","PUT","CONNECT","DELETE","HEAD"],"weights":[0.52,0.22,0.06,0.1,0.04,0.06]}},
    {"name":"respcode","type":"enum","config":{"values":["200","301","304","400","403","404","500","503"],"weights":[0.52,0.08,0.1,0.06,0.05,0.08,0.06,0.05]}},
    {"name":"riskscore","type":"int","config":{"min":0,"max":100}},
    {"name":"threatname","type":"enum","config":{"values":["None","Adware","Trojan","Phishing","Cryptominer"],"weights":[0.86,0.04,0.04,0.03,0.03]}},
    {"name":"deviceowner","type":"username","config":{"pattern":"{first}.{last}"}},
    {"name":"devicehostname","type":"hostname","config":{"pool":["WKS-FIN-PC07","WKS-IT-PC01","LAPTOP-A3B7C9D","LAPTOP-K8M2P4Q","WKS-ENG-PC08","WKS-EXEC-PC01"]}},
    {"name":"rulelabel","type":"string","config":{"pool":["Default Allow","Block Malware","Caution Streaming","Allow Business","Isolate Unknown","Allow SaaS","DLP Restrict"]}},
    {"name":"appname","type":"enum","config":{"values":["Microsoft 365","Google Suite","Slack","Zoom","AWS Console","GitHub","Salesforce","YouTube","Okta","General Web"],"weights":[0.15,0.11,0.1,0.09,0.09,0.09,0.09,0.08,0.08,0.12]}}
  ],
  "template":"{\"datetime\":\"{{datetime}}\",\"user\":\"{{user}}\",\"department\":\"{{department}}\",\"url\":\"{{url}}\",\"action\":\"{{action}}\",\"urlcategory\":\"{{urlcategory}}\",\"dlpengine\":\"{{dlpengine}}\",\"location\":\"{{location}}\",\"reqsize\":{{reqsize}},\"respsize\":{{respsize}},\"serverip\":\"{{serverip}}\",\"clientip\":\"{{clientip}}\",\"reqmethod\":\"{{reqmethod}}\",\"respcode\":\"{{respcode}}\",\"riskscore\":{{riskscore}},\"threatname\":\"{{threatname}}\",\"deviceowner\":\"{{deviceowner}}\",\"devicehostname\":\"{{devicehostname}}\",\"rulelabel\":\"{{rulelabel}}\",\"appname\":\"{{appname}}\"}",
  "correlationHints":{"actor_ip":"clientip","actor_user":"user","target_ip":"serverip"}
