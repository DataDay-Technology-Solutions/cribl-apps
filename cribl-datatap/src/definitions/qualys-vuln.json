{
  "sourcetype":"qualys:hostDetection","vendor":"Qualys","product":"Qualys VM","format":"json",
  "description":"Qualys vulnerability scan host detection events",
  "templatePrefix":"{",
  "templateSuffix":"}",
  "fields":[
    {"name":"ts","type":"timestamp","config":{"format":"iso","jitterMs":60000}},
    {"name":"id","type":"int","config":{"min":10000000,"max":99999999}},
    {"name":"qid","type":"enum","config":{"values":[38173,38623,38780,82003,82054,90058,90193,90414,105170,105505,105760],"weights":[0.1,0.1,0.09,0.1,0.09,0.1,0.09,0.09,0.08,0.08,0.08]}},
    {"name":"vtype","type":"enum","config":{"values":["Confirmed","Potential","Information Gathered"],"weights":[0.5,0.3,0.2]}},
    {"name":"sev","type":"enum","config":{"values":[1,2,3,4,5],"weights":[0.15,0.2,0.3,0.2,0.15]}},
    {"name":"port","type":"port","config":{"common":[443,80,22,3389,445,8080,8443,3306],"weights":[0.22,0.18,0.14,0.1,0.1,0.1,0.08,0.08]}},
    {"name":"proto","type":"enum","config":{"values":["tcp","udp"],"weights":[0.85,0.15]}},
    {"name":"fqdn","type":"string","config":{"pool":["srv-web01.corp.contoso.com","srv-db01.corp.contoso.com","srv-app01.corp.contoso.com","srv-dc01.corp.contoso.com","srv-file01.corp.contoso.com","srv-sql01.corp.contoso.com","srv-vpn01.corp.contoso.com","srv-proxy01.corp.contoso.com"]}},
    {"name":"ssl","type":"enum","config":{"values":[true,false],"weights":[0.4,0.6]}},
    {"name":"results","type":"string","config":{"pool":["SSL Certificate - Subject CN mismatch","OpenSSH version 7.4 detected","Apache httpd 2.4.6 - multiple vulnerabilities","TLS 1.0 enabled on port 443","SMBv1 enabled on port 445","nginx 1.18.0 - HTTP request smuggling","Self-signed certificate on port 8443","Remote Desktop NLA not enforced"]}},
    {"name":"status","type":"enum","config":{"values":["New","Active","Fixed","Re-Opened"],"weights":[0.2,0.5,0.2,0.1]}},
    {"name":"tf","type":"int","config":{"min":1,"max":50}},
    {"name":"hostId","type":"int","config":{"min":10000,"max":9999999}},
    {"name":"ip","type":"ip","config":{"internal":[{"cidr":"10.0.0.0/8","weight":0.6},{"cidr":"192.168.0.0/16","weight":0.25},{"cidr":"172.16.0.0/12","weight":0.15}]}},
    {"name":"tm","type":"enum","config":{"values":["IP","DNS","NETBIOS","AGENT"],"weights":[0.3,0.3,0.15,0.25]}},
    {"name":"os","type":"string","config":{"pool":["Windows Server 2019 Standard","Windows Server 2016 Datacenter","Ubuntu 20.04.3 LTS","RHEL 8.4","CentOS 7.9","Amazon Linux 2"]}},
    {"name":"dns","type":"string","config":{"pool":["srv-web01","srv-db01","srv-app01","srv-dc01","srv-file01","srv-sql01","srv-vpn01","srv-proxy01"]}}
  ],
  "variants":{
    "confirmed":{"weight":0.45,
      "fields":{"vtype":"Confirmed"},
      "bodyTemplate":"\"ID\":{{id}},\"QID\":{{qid}},\"Type\":\"Confirmed\",\"Severity\":{{sev}},\"Port\":{{port}},\"Protocol\":\"{{proto}}\",\"FQDN\":\"{{fqdn}}\",\"SSL\":{{ssl}},\"RESULTS\":\"{{results}}\",\"STATUS\":\"{{status}}\",\"FIRST_FOUND_DATETIME\":\"{{ts}}\",\"LAST_FOUND_DATETIME\":\"{{ts}}\",\"TIMES_FOUND\":{{tf}},\"LAST_TEST_DATETIME\":\"{{ts}}\",\"IS_IGNORED\":false,\"IS_DISABLED\":false,\"HOST_ID\":{{hostId}},\"IP\":\"{{ip}}\",\"TRACKING_METHOD\":\"{{tm}}\",\"OS\":\"{{os}}\",\"DNS\":\"{{dns}}\",\"LAST_SCAN_DATETIME\":\"{{ts}}\",\"VULN_STATUS\":\"{{status}}\""},
    "potential":{"weight":0.30,
      "fields":{"vtype":"Potential"},
      "bodyTemplate":"\"ID\":{{id}},\"QID\":{{qid}},\"Type\":\"Potential\",\"Severity\":{{sev}},\"Port\":{{port}},\"Protocol\":\"{{proto}}\",\"FQDN\":\"{{fqdn}}\",\"SSL\":{{ssl}},\"RESULTS\":\"{{results}}\",\"STATUS\":\"{{status}}\",\"FIRST_FOUND_DATETIME\":\"{{ts}}\",\"LAST_FOUND_DATETIME\":\"{{ts}}\",\"TIMES_FOUND\":{{tf}},\"LAST_TEST_DATETIME\":\"{{ts}}\",\"IS_IGNORED\":false,\"IS_DISABLED\":false,\"HOST_ID\":{{hostId}},\"IP\":\"{{ip}}\",\"TRACKING_METHOD\":\"{{tm}}\",\"OS\":\"{{os}}\",\"DNS\":\"{{dns}}\",\"LAST_SCAN_DATETIME\":\"{{ts}}\",\"VULN_STATUS\":\"{{status}}\""},
    "info":{"weight":0.25,
      "fields":{"vtype":"Information Gathered"},
      "bodyTemplate":"\"ID\":{{id}},\"QID\":{{qid}},\"Type\":\"Information Gathered\",\"Severity\":1,\"Port\":{{port}},\"Protocol\":\"{{proto}}\",\"FQDN\":\"{{fqdn}}\",\"SSL\":{{ssl}},\"RESULTS\":\"{{results}}\",\"STATUS\":\"Active\",\"FIRST_FOUND_DATETIME\":\"{{ts}}\",\"LAST_FOUND_DATETIME\":\"{{ts}}\",\"TIMES_FOUND\":{{tf}},\"LAST_TEST_DATETIME\":\"{{ts}}\",\"IS_IGNORED\":false,\"IS_DISABLED\":false,\"HOST_ID\":{{hostId}},\"IP\":\"{{ip}}\",\"TRACKING_METHOD\":\"{{tm}}\",\"OS\":\"{{os}}\",\"DNS\":\"{{dns}}\",\"LAST_SCAN_DATETIME\":\"{{ts}}\",\"VULN_STATUS\":\"Active\""}
  },
  "template":"{{templatePrefix}}{{bodyTemplate}}{{templateSuffix}}",
  "correlationHints":{"target_ip":"ip","target_host":"fqdn","vuln_id":"qid"}
}