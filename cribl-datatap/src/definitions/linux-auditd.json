{
  "sourcetype":"linux:auditd","vendor":"Linux","product":"Audit Daemon","format":"kv",
  "description":"Linux audit daemon log events",
  "fields":[
    {"name":"epoch","type":"timestamp","config":{"format":"epoch_s","jitterMs":3000}},
    {"name":"serial","type":"int","config":{"min":1000,"max":99999999}},
    {"name":"arch","type":"enum","config":{"values":["c000003e","40000003"],"weights":[0.85,0.15]}},
    {"name":"sc","type":"enum","config":{"values":["59","2","257","56","49","42","21","3","0","41"],"weights":[0.18,0.12,0.12,0.08,0.08,0.1,0.08,0.08,0.08,0.08]}},
    {"name":"succ","type":"enum","config":{"values":["yes","no"],"weights":[0.82,0.18]}},
    {"name":"exit","type":"enum","config":{"values":["0","-13","-2","-1","1"],"weights":[0.7,0.1,0.08,0.07,0.05]}},
    {"name":"pid","type":"int","config":{"min":100,"max":65535}},
    {"name":"ppid","type":"int","config":{"min":1,"max":65535}},
    {"name":"auid","type":"enum","config":{"values":["1000","1001","0","4294967295"],"weights":[0.35,0.2,0.25,0.2]}},
    {"name":"uid","type":"enum","config":{"values":["0","1000","1001","33","999"],"weights":[0.3,0.25,0.2,0.15,0.1]}},
    {"name":"gid","type":"enum","config":{"values":["0","1000","1001","33","999"],"weights":[0.3,0.25,0.2,0.15,0.1]}},
    {"name":"euid","type":"enum","config":{"values":["0","1000","1001","33"],"weights":[0.35,0.3,0.2,0.15]}},
    {"name":"tty","type":"enum","config":{"values":["pts0","pts1","pts2","(none)","tty1"],"weights":[0.3,0.2,0.15,0.25,0.1]}},
    {"name":"ses","type":"int","config":{"min":1,"max":99999}},
    {"name":"comm","type":"string","config":{"pool":["bash","sshd","sudo","cron","systemctl","useradd","passwd","su","chmod","chown","iptables","docker","yum","curl","wget","cat","grep","find","rm","tar","ssh","rsync"]}},
    {"name":"exe","type":"string","config":{"pool":["/usr/bin/bash","/usr/sbin/sshd","/usr/bin/sudo","/usr/sbin/crond","/usr/bin/systemctl","/usr/sbin/useradd","/usr/bin/passwd","/usr/bin/su","/usr/bin/chmod","/usr/bin/curl","/usr/bin/wget","/usr/bin/docker","/usr/bin/ssh","/usr/lib/systemd/systemd"]}},
    {"name":"key","type":"enum","config":{"values":["user_cmds","file_access","priv_esc","network","system_config","(null)"],"weights":[0.2,0.18,0.15,0.12,0.15,0.2]}},
    {"name":"acct","type":"string","config":{"pool":["root","admin","deploy","jsmith","jdoe","svcacct","backup"]}},
    {"name":"cwd","type":"string","config":{"pool":["/root","/home/admin","/home/deploy","/tmp","/var/tmp","/opt/app"]}},
    {"name":"pth","type":"string","config":{"pool":["/etc/passwd","/etc/shadow","/etc/sudoers","/etc/ssh/sshd_config","/var/log/auth.log","/tmp/script.sh","/etc/crontab","/root/.ssh/authorized_keys"]}}
  ],
  "variants":{
    "syscall":{"weight":0.30,
      "fields":{"type":"SYSCALL"},
      "template":"type=SYSCALL msg=audit({{epoch}}:{{serial}}): arch={{arch}} syscall={{sc}} success={{succ}} exit={{exit}} a0=0x7f a1=0x1 a2=0x0 a3=0x0 items=1 ppid={{ppid}} pid={{pid}} auid={{auid}} uid={{uid}} gid={{gid}} euid={{euid}} suid={{uid}} fsuid={{uid}} egid={{gid}} sgid={{gid}} fsgid={{gid}} tty={{tty}} ses={{ses}} comm=\"{{comm}}\" exe=\"{{exe}}\" key=\"{{key}}\""},
    "execve":{"weight":0.20,
      "fields":{"type":"EXECVE"},
      "template":"type=EXECVE msg=audit({{epoch}}:{{serial}}): argc=3 a0=\"{{exe}}\" a1=\"-c\" a2=\"{{comm}}\""},
    "path":{"weight":0.12,
      "fields":{"type":"PATH"},
      "template":"type=PATH msg=audit({{epoch}}:{{serial}}): item=0 name=\"{{pth}}\" inode=262155 dev=08:01 mode=0100644 ouid={{uid}} ogid={{gid}} rdev=00:00 nametype=NORMAL"},
    "user_auth":{"weight":0.15,
      "fields":{"type":"USER_AUTH"},
      "template":"type=USER_AUTH msg=audit({{epoch}}:{{serial}}): pid={{pid}} uid={{uid}} auid={{auid}} ses={{ses}} msg='op=PAM:authentication grantors=pam_unix acct=\"{{acct}}\" exe=\"{{exe}}\" hostname=? addr=? terminal={{tty}} res={{succ}}'"},
    "user_login":{"weight":0.10,
      "fields":{"type":"USER_LOGIN"},
      "template":"type=USER_LOGIN msg=audit({{epoch}}:{{serial}}): pid={{pid}} uid=0 auid={{auid}} ses={{ses}} msg='op=login id={{uid}} exe=\"/usr/sbin/sshd\" hostname=? addr=? terminal=/dev/{{tty}} res={{succ}}'"},
    "service":{"weight":0.08,
      "fields":{"type":"SERVICE_START"},
      "template":"type=SERVICE_START msg=audit({{epoch}}:{{serial}}): pid=1 uid=0 auid=4294967295 ses=4294967295 msg='unit={{comm}} comm=\"systemd\" exe=\"/usr/lib/systemd/systemd\" hostname=? addr=? terminal=? res={{succ}}'"},
    "cwd_rec":{"weight":0.05,
      "fields":{"type":"CWD"},
      "template":"type=CWD msg=audit({{epoch}}:{{serial}}): cwd=\"{{cwd}}\""}
  },
  "template":"type={{type}} msg=audit({{epoch}}:{{serial}}): {{body}}",
  "correlationHints":{"actor_uid":"uid","actor_auid":"auid","process_id":"pid"}
}