{
  "sourcetype":"azure:aad:signin","vendor":"Microsoft","product":"Azure AD / Entra ID","format":"json",
  "description":"Azure Active Directory sign-in and activity events",
  "fields":[
    {"name":"ts","type":"timestamp","config":{"format":"iso","jitterMs":5000}},
    {"name":"cid","type":"uuid","config":{}},
    {"name":"uid","type":"uuid","config":{}},
    {"name":"upn","type":"email","config":{"domains":["contoso.com","fabrikam.com","northwind.com"]}},
    {"name":"udn","type":"username","config":{"pattern":"{First} {Last}"}},
    {"name":"cip","type":"ip","config":{"internal":[{"cidr":"10.0.0.0/8","weight":0.3}],"external":[{"cidr":"0.0.0.0/0","weight":0.7}]}},
    {"name":"appid","type":"uuid","config":{}},
    {"name":"appdn","type":"string","config":{"pool":["Microsoft Office 365 Portal","Azure Portal","Microsoft Teams","Outlook Mobile","SharePoint Online","OneDrive for Business","Microsoft Graph","Power BI Service","Dynamics 365","Azure DevOps","Microsoft Intune","My Apps","Windows Sign-In","Microsoft Edge","Microsoft Defender","Salesforce","Slack","Zoom","ServiceNow","Workday"]}},
    {"name":"loc","type":"string","config":{"pool":["US","US","US","US","GB","DE","FR","CA","AU","JP","IN","BR","NL","SG","IE","SE","KR","MX","IL","IT"]}},
    {"name":"city","type":"string","config":{"pool":["New York","San Francisco","Chicago","Seattle","London","Los Angeles","Austin","Denver","Boston","Atlanta","Toronto","Dublin","Frankfurt","Amsterdam","Tokyo","Singapore","Sydney","Mumbai","Sao Paulo","Paris"]}},
    {"name":"devid","type":"uuid","config":{}},
    {"name":"os","type":"enum","config":{"values":["Windows 10","Windows 11","MacOS","iOS","Android","Linux","ChromeOS"],"weights":[0.25,0.2,0.18,0.14,0.1,0.08,0.05]}},
    {"name":"browser","type":"enum","config":{"values":["Edge 122","Chrome 123","Safari 17","Firefox 124","Outlook 16","Mobile Safari","Chrome Mobile","Edge Mobile"],"weights":[0.25,0.22,0.15,0.08,0.1,0.08,0.07,0.05]}},
    {"name":"rid","type":"string","config":{"pattern":"/subscriptions/{random:8}-{random:4}-{random:4}-{random:4}-{random:12}/resourcegroups/SignInLogs"}}
  ],
  "jsonBase":{"time":"{{ts}}","resourceId":"{{rid}}","operationName":"{{opn}}","category":"{{cat}}","resultType":"{{rt}}","resultDescription":"{{rd}}","callerIpAddress":"{{cip}}","correlationId":"{{cid}}","level":"{{lvl}}","location":"{{loc}}"},
  "variants":{
    "success":{"weight":0.45,
      "fields":{"opn":"Sign-in activity","cat":"SignInLogs","rt":"0","rd":"","lvl":"4"},
      "jsonMerge":{"properties":{"userDisplayName":"{{udn}}","userPrincipalName":"{{upn}}","userId":"{{uid}}","appId":"{{appid}}","appDisplayName":"{{appdn}}","ipAddress":"{{cip}}","clientAppUsed":"{{cau}}","status":{"errorCode":0,"additionalDetails":"MFA completed in Azure AD"},"deviceDetail":{"operatingSystem":"{{os}}","browser":"{{browser}}","deviceId":"{{devid}}","isCompliant":true,"isManaged":true},"location":{"city":"{{city}}","countryOrRegion":"{{loc}}"},"mfaDetail":{"authMethod":"PhoneAppNotification"},"riskState":"none","riskLevelAggregated":"none","conditionalAccessStatus":"success"}},
      "extraFields":{"cau":{"type":"enum","config":{"values":["Browser","Mobile Apps and Desktop clients","Exchange ActiveSync"],"weights":[0.45,0.45,0.1]}}}},
    "mfa_req":{"weight":0.15,
      "fields":{"opn":"Sign-in activity","cat":"SignInLogs","rt":"50074","rd":"Strong Authentication is required.","lvl":"4"},
      "jsonMerge":{"properties":{"userDisplayName":"{{udn}}","userPrincipalName":"{{upn}}","userId":"{{uid}}","appId":"{{appid}}","appDisplayName":"{{appdn}}","ipAddress":"{{cip}}","clientAppUsed":"Browser","status":{"errorCode":50074,"failureReason":"Strong Authentication is required."},"deviceDetail":{"operatingSystem":"{{os}}","browser":"{{browser}}"},"location":{"city":"{{city}}","countryOrRegion":"{{loc}}"},"riskState":"none","riskLevelAggregated":"low","conditionalAccessStatus":"notApplied"}}},
    "bad_cred":{"weight":0.15,
      "fields":{"opn":"Sign-in activity","cat":"SignInLogs","rt":"50126","rd":"Invalid username or password.","lvl":"4"},
      "jsonMerge":{"properties":{"userDisplayName":"{{udn}}","userPrincipalName":"{{upn}}","userId":"{{uid}}","appId":"{{appid}}","appDisplayName":"{{appdn}}","ipAddress":"{{cip}}","clientAppUsed":"Browser","status":{"errorCode":50126,"failureReason":"Invalid username or password."},"deviceDetail":{"operatingSystem":"{{os}}","browser":"{{browser}}"},"location":{"city":"{{city}}","countryOrRegion":"{{loc}}"},"riskState":"atRisk","riskLevelAggregated":"medium","conditionalAccessStatus":"notApplied"}}},
    "ca_block":{"weight":0.10,
      "fields":{"opn":"Sign-in activity","cat":"SignInLogs","rt":"53003","rd":"Access has been blocked by Conditional Access policies.","lvl":"4"},
      "jsonMerge":{"properties":{"userDisplayName":"{{udn}}","userPrincipalName":"{{upn}}","userId":"{{uid}}","appId":"{{appid}}","appDisplayName":"{{appdn}}","ipAddress":"{{cip}}","clientAppUsed":"Browser","status":{"errorCode":53003,"failureReason":"Blocked by Conditional Access"},"deviceDetail":{"operatingSystem":"{{os}}","browser":"{{browser}}","isCompliant":false,"isManaged":false},"location":{"city":"{{city}}","countryOrRegion":"{{loc}}"},"riskState":"atRisk","riskLevelAggregated":"high","conditionalAccessStatus":"failure"}}},
    "legacy_auth":{"weight":0.08,
      "fields":{"opn":"Sign-in activity","cat":"SignInLogs","rt":"50126","rd":"Legacy authentication blocked.","lvl":"4"},
      "jsonMerge":{"properties":{"userDisplayName":"{{udn}}","userPrincipalName":"{{upn}}","userId":"{{uid}}","appId":"{{appid}}","appDisplayName":"Exchange Online","ipAddress":"{{cip}}","clientAppUsed":"Other clients","status":{"errorCode":50126,"failureReason":"Legacy authentication blocked"},"deviceDetail":{"operatingSystem":"{{os}}"},"location":{"city":"{{city}}","countryOrRegion":"{{loc}}"},"riskState":"none","riskLevelAggregated":"none","conditionalAccessStatus":"failure"}}},
    "risky":{"weight":0.07,
      "fields":{"opn":"Sign-in activity","cat":"SignInLogs","rt":"0","rd":"","lvl":"4","rdet":{"type":"enum","config":{"values":["anonymizedIPAddress","unfamiliarFeatures","maliciousIPAddress","leakedCredentials","suspiciousIPAddress"],"weights":[0.3,0.25,0.2,0.15,0.1]}}},
      "jsonMerge":{"properties":{"userDisplayName":"{{udn}}","userPrincipalName":"{{upn}}","userId":"{{uid}}","appId":"{{appid}}","appDisplayName":"{{appdn}}","ipAddress":"{{cip}}","clientAppUsed":"Browser","status":{"errorCode":0},"deviceDetail":{"operatingSystem":"{{os}}","browser":"{{browser}}"},"location":{"city":"{{city}}","countryOrRegion":"{{loc}}"},"riskState":"atRisk","riskLevelAggregated":"high","riskDetail":"{{rdet}}","conditionalAccessStatus":"success"}}}
  },
  "template":"json_merge",
  "correlationHints":{"actor_ip":"cip","actor_user":"upn","actor_name":"udn"}
}