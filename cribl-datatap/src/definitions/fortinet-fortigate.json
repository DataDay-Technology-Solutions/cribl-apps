{
  "sourcetype":"fortigate:traffic","vendor":"Fortinet","product":"FortiGate","format":"kv",
  "description":"Fortinet FortiGate firewall traffic log in key-value format",
  "fields":[
    {"name":"date","type":"timestamp","config":{"format":"YYYY-MM-DD","jitterMs":0}},
    {"name":"time","type":"timestamp","config":{"format":"HH:mm:ss","jitterMs":2000}},
    {"name":"devname","type":"hostname","config":{"pool":["FG-600E-DC1","FG-600E-DC2","FG-400F-EDGE","FG-100F-BRANCH01","FG-3600E-CORE","FG-1100E-DMZ","FG-60F-SITE01","FG-1800F-HQ"]}},
    {"name":"devid","type":"string","config":{"pool":["FG6H0E1234567890","FG4H0F3456789012","FG1H0F4567890123","FG3K6E6789012345","FG1K1E7890123456","FG060F9012345678","FG1K8F1234567890","FG2K6F2345678901"]}},
    {"name":"logid","type":"string","config":{"pool":["0000000013","0000000020","0001000014","0000000010","0000000011","0000000022"]}},
    {"name":"type","type":"enum","config":{"values":["traffic"],"weights":[1]}},
    {"name":"subtype","type":"enum","config":{"values":["forward","local","sniffer"],"weights":[0.8,0.15,0.05]}},
    {"name":"level","type":"enum","config":{"values":["notice","information","warning","error"],"weights":[0.4,0.35,0.15,0.1]}},
    {"name":"vd","type":"string","config":{"pool":["root","CORP","DMZ","GUEST","MGMT"]}},
    {"name":"srcip","type":"ip","config":{"internal":[{"cidr":"10.0.0.0/8","weight":0.45},{"cidr":"192.168.0.0/16","weight":0.25}],"external":[{"cidr":"0.0.0.0/0","weight":0.3}]}},
    {"name":"srcport","type":"port","config":{"type":"ephemeral"}},
    {"name":"srcintf","type":"enum","config":{"values":["port1","port2","port3","port4","wan1","wan2","dmz","ssl.root","internal"],"weights":[0.15,0.12,0.1,0.08,0.18,0.1,0.1,0.09,0.08]}},
    {"name":"dstip","type":"ip","config":{"internal":[{"cidr":"10.0.0.0/8","weight":0.25}],"external":[{"cidr":"0.0.0.0/0","weight":0.75}]}},
    {"name":"dstport","type":"port","config":{"common":[443,80,53,8443,22,25,3389,993,587,8080],"weights":[0.28,0.18,0.14,0.07,0.06,0.05,0.05,0.06,0.06,0.05]}},
    {"name":"dstintf","type":"enum","config":{"values":["wan1","wan2","port1","port2","port3","dmz","ssl.root","internal"],"weights":[0.25,0.15,0.12,0.1,0.08,0.12,0.1,0.08]}},
    {"name":"policyid","type":"int","config":{"min":1,"max":500}},
    {"name":"policyname","type":"string","config":{"pool":["Corp-Internet","DMZ-Inbound","VPN-Split","Guest-Web","Allow-DNS","Deny-Default","Mail-Outbound","SaaS-Allow","Mgmt-Access","PCI-Segment"]}},
    {"name":"action","type":"enum","config":{"values":["accept","deny","close","ip-conn","timeout"],"weights":[0.75,0.08,0.08,0.05,0.04]}},
    {"name":"proto","type":"enum","config":{"values":["6","17","1","47"],"weights":[0.65,0.27,0.05,0.03]}},
    {"name":"service","type":"enum","config":{"values":["HTTPS","HTTP","DNS","SSH","SMTP","RDP","FTP","IMAP","POP3","NTP","SNMP","LDAP","SMB"],"weights":[0.28,0.17,0.13,0.06,0.05,0.05,0.03,0.04,0.03,0.04,0.03,0.05,0.04]}},
    {"name":"duration","type":"int","config":{"min":0,"max":7200}},
    {"name":"sentbyte","type":"int","config":{"min":40,"max":524288}},
    {"name":"rcvdbyte","type":"int","config":{"min":40,"max":524288}},
    {"name":"sentpkt","type":"int","config":{"min":1,"max":8000}},
    {"name":"rcvdpkt","type":"int","config":{"min":1,"max":8000}},
    {"name":"appcat","type":"enum","config":{"values":["unscanned","Web.Client","Network.Service","Email","Cloud.IT","Collaboration","Social.Media","Video/Audio","Storage.Backup","Update","General.Interest","Business"],"weights":[0.15,0.14,0.1,0.08,0.09,0.07,0.06,0.06,0.05,0.06,0.07,0.07]}},
    {"name":"app","type":"enum","config":{"values":["SSL_TLS","HTTP-BROWSER","DNS","Outlook.Office365","Zoom","Microsoft.Teams","Slack","Google.HTTPS","GitHub","SMTP","SSH","LDAP","RDP","NTP"],"weights":[0.12,0.11,0.11,0.08,0.07,0.07,0.07,0.07,0.06,0.05,0.05,0.05,0.05,0.04]}},
    {"name":"srcmac","type":"string","config":{"pool":["00:1a:2b:3c:4d:5e","a4:5e:60:b1:c2:d3","d8:f1:22:33:44:55","e8:65:49:ab:cd:ef","b4:96:91:12:34:56","c0:ff:ee:00:11:22"]}}
  ],
  "template":"date={{date}} time={{time}} devname=\"{{devname}}\" devid=\"{{devid}}\" logid=\"{{logid}}\" type=\"{{type}}\" subtype=\"{{subtype}}\" level=\"{{level}}\" vd=\"{{vd}}\" srcip={{srcip}} srcport={{srcport}} srcintf=\"{{srcintf}}\" dstip={{dstip}} dstport={{dstport}} dstintf=\"{{dstintf}}\" policyid={{policyid}} policyname=\"{{policyname}}\" action=\"{{action}}\" proto={{proto}} service=\"{{service}}\" duration={{duration}} sentbyte={{sentbyte}} rcvdbyte={{rcvdbyte}} sentpkt={{sentpkt}} rcvdpkt={{rcvdpkt}} appcat=\"{{appcat}}\" app=\"{{app}}\" srcmac=\"{{srcmac}}\"",
  "correlationHints":{"actor_ip":"srcip","target_ip":"dstip","target_port":"dstport"}
}