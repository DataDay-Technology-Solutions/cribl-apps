{
  "sourcetype":"duo:authentication","vendor":"Cisco","product":"Duo Security","format":"json",
  "description":"Duo Security authentication log events",
  "fields":[
    {"name":"ts","type":"timestamp","config":{"format":"epoch","jitterMs":5000}},
    {"name":"txid","type":"uuid","config":{}},
    {"name":"user","type":"username","config":{"pattern":"{first}.{last}"}},
    {"name":"email","type":"email","config":{"domains":["contoso.com","fabrikam.com"]}},
    {"name":"alias","type":"username","config":{"pattern":"{first}.{last}"}},
    {"name":"ip","type":"ip","config":{"internal":[{"cidr":"10.0.0.0/8","weight":0.35}],"external":[{"cidr":"0.0.0.0/0","weight":0.65}]}},
    {"name":"intg","type":"string","config":{"pool":["VPN Gateway","Microsoft Azure","AWS Console","Salesforce","Office 365","Outlook Web Access","Remote Desktop Gateway","SSH Gateway","Citrix NetScaler","Palo Alto GlobalProtect","Cisco AnyConnect","RADIUS Proxy","Workday","GitHub Enterprise","Jira Cloud","ServiceNow","Okta","Slack Enterprise"]}},
    {"name":"city","type":"string","config":{"pool":["New York","San Francisco","Chicago","Seattle","London","Los Angeles","Austin","Denver","Boston","Atlanta","Toronto","Dublin","Frankfurt","Amsterdam","Tokyo","Singapore","Mumbai","Paris"]}},
    {"name":"state","type":"string","config":{"pool":["New York","California","Illinois","Washington","England","California","Texas","Colorado","Massachusetts","Georgia","Ontario","Leinster","Hessen","North Holland","Tokyo","Singapore","Maharashtra","Ile-de-France"]}},
    {"name":"country","type":"string","config":{"pool":["US","US","US","US","GB","US","US","US","US","US","CA","IE","DE","NL","JP","SG","IN","FR"]}},
    {"name":"devname","type":"string","config":{"pool":["iPhone 15 Pro","iPhone 14","Samsung Galaxy S24","Google Pixel 8","iPhone 15","iPad Pro","Samsung Galaxy S23","iPhone 13","Google Pixel 7","MacBook Pro Touch ID","YubiKey 5","Android Phone"]}}
  ],
  "jsonBase":{"timestamp":"{{ts}}","txid":"{{txid}}","eventtype":"{{etype}}","result":"{{res}}","reason":"{{rsn}}","username":"{{user}}","alias":"{{alias}}","email":"{{email}}","factor":"{{fac}}","integration":"{{intg}}","ip":"{{ip}}","new_enrollment":false},
  "variants":{
    "push_ok":{"weight":0.40,
      "fields":{"etype":"authentication","res":"SUCCESS","rsn":"User approved","fac":"Duo Push"},
      "jsonMerge":{"device":"{{devname}}","location":{"city":"{{city}}","state":"{{state}}","country":"{{country}}"}}},
    "push_deny":{"weight":0.08,
      "fields":{"etype":"authentication","res":"DENIED","rsn":"User denied","fac":"Duo Push"},
      "jsonMerge":{"device":"{{devname}}","location":{"city":"{{city}}","state":"{{state}}","country":"{{country}}"}}},
    "passcode_ok":{"weight":0.15,
      "fields":{"etype":"authentication","res":"SUCCESS","rsn":"Valid passcode","fac":"Passcode"},
      "jsonMerge":{"device":"{{devname}}","location":{"city":"{{city}}","state":"{{state}}","country":"{{country}}"}}},
    "passcode_fail":{"weight":0.06,
      "fields":{"etype":"authentication","res":"DENIED","rsn":"Invalid passcode","fac":"Passcode"},
      "jsonMerge":{"device":"{{devname}}","location":{"city":"{{city}}","state":"{{state}}","country":"{{country}}"}}},
    "phone_ok":{"weight":0.08,
      "fields":{"etype":"authentication","res":"SUCCESS","rsn":"User approved","fac":"Phone Call"},
      "jsonMerge":{"device":"{{devname}}","location":{"city":"{{city}}","state":"{{state}}","country":"{{country}}"}}},
    "bypass":{"weight":0.05,
      "fields":{"etype":"authentication","res":"SUCCESS","rsn":"Bypass code used","fac":"Bypass Code"},
      "jsonMerge":{"device":"N/A","location":{"city":"{{city}}","state":"{{state}}","country":"{{country}}"}}},
    "hw_token":{"weight":0.05,
      "fields":{"etype":"authentication","res":"SUCCESS","rsn":"Valid passcode","fac":"Hardware Token"},
      "jsonMerge":{"device":"YubiKey 5","location":{"city":"{{city}}","state":"{{state}}","country":"{{country}}"}}},
    "fraud":{"weight":0.03,
      "fields":{"etype":"authentication","res":"FRAUD","rsn":"User reported fraud","fac":"Duo Push"},
      "jsonMerge":{"device":"{{devname}}","location":{"city":"{{city}}","state":"{{state}}","country":"{{country}}"}}},
    "anomalous":{"weight":0.05,
      "fields":{"etype":"authentication","res":"DENIED","rsn":"Anomalous push","fac":"Duo Push"},
      "jsonMerge":{"device":"{{devname}}","location":{"city":"{{city}}","state":"{{state}}","country":"{{country}}"}}},
    "enroll":{"weight":0.05,
      "fields":{"etype":"enrollment","res":"SUCCESS","rsn":"User enrolled","fac":"Duo Push"},
      "jsonMerge":{"new_enrollment":true,"device":"{{devname}}","location":{"city":"{{city}}","state":"{{state}}","country":"{{country}}"}}}
  },
  "template":"json_merge",
  "correlationHints":{"actor_ip":"ip","actor_user":"user","actor_email":"email"}
}