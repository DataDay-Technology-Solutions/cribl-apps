    {"name":"dip","type":"ip","config":{"internal":[{"cidr":"10.0.0.0/8","weight":0.5},{"cidr":"172.16.0.0/12","weight":0.15}],"external":[{"cidr":"0.0.0.0/0","weight":0.35}]}},
