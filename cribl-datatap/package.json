    "demo": "node src/cli.js stream --sourcetype palo-alto-traffic --eps 10 --duration 30",
    "demo:scenario": "node src/cli.js scenario --name brute-force --eps 50 --duration 60"
  },
  "keywords": [
    "cribl",
    "stream",
    "datagen",
    "data-generation",
    "security",
    "siem",
    "test-data",
    "streaming"
  ],
