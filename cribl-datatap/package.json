{
  "name": "cribl-datatap",
  "version": "0.1.0",
  "description": "On-demand production-realistic streaming data generation for Cribl Stream",
  "main": "src/index.js",
  "bin": {
    "datatap": "./src/cli.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "cli": "node src/cli.js",
    "test": "node --test tests/**/*.test.js",
